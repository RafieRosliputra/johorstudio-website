# Salin fail ni jadi .env:   cp .env.example .env
# Kemudian isi nilai di bawah.

# Rahsia untuk Silex (bina guna: openssl rand -base64 32)
SILEX_SESSION_SECRET=tukar-kepada-rentetan-rawak-sekurang-kurangnya-32-aksara

# Alamat Silex dari laptop kau, contoh http://192.168.1.10:6805
SILEX_URL=http://localhost:6805

# Token Cloudflare Tunnel (Cloudflare Zero Trust > Networks > Tunnels)
TUNNEL_TOKEN=
